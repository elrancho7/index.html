<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Baby Harambe's Revenge</title>
    <style>
        body {
            margin: 0;
            background: #0a0e14;
            color: #fff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            text-align: center;
            touch-action: manipulation;
            overflow: hidden;
        }
        h1 { font-size: 14px; margin: 3px 0; color: #00ffcc; text-shadow: 0 0 8px rgba(0,255,204,0.4); }
        
        /* Web3 Top Bar */
        .web3-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #11161d;
            padding: 4px 8px;
            font-size: 10px;
            border-bottom: 1px solid #30363d;
        }
        .wallet-btn {
            background: #9945FF;
            color: #fff;
            border: none;
            padding: 4px 8px;
            font-size: 10px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
        }
        .wallet-info { color: #00ffcc; font-weight: bold; }

        .ui-panel { display: flex; justify-content: space-around; font-size: 11px; color: #8b949e; background: #161b22; padding: 4px 0; border-bottom: 1px solid #30363d; }
        .ui-panel span { color: #ffd700; font-weight: bold; }
        #boss-alert { font-size: 11px; height: 14px; color: #ff4444; font-weight: bold; margin: 2px 0; }
        
        #game-container {
            position: relative;
            width: 100vw;
            max-width: 400px;
            height: 190px;
            background: radial-gradient(circle, #1a2f23 0%, #0d1a12 100%);
            margin: 0 auto;
            border-top: 2px solid #30363d;
            border-bottom: 2px solid #30363d;
            overflow: hidden;
        }
        canvas { display: block; width: 100%; height: 100%; }

        /* Smartphone Touch Controls */
        .controls {
            display: flex;
            justify-content: space-around;
            align-items: center;
            width: 100vw;
            max-width: 400px;
            margin: 4px auto;
            padding: 0 10px;
            box-sizing: border-box;
        }
        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .control-btn {
            background: #161b22;
            color: #fff;
            border: 2px solid #30363d;
            font-size: 14px;
            padding: 5px 12px;
            border-radius: 6px;
            cursor: pointer;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        .control-btn:active { background: #30363d; transform: scale(0.95); }
        #throw-btn {
            background: linear-gradient(135deg, #f0883e 0%, #d16922 100%);
            border-color: #ffa657;
            color: #fff;
            font-weight: bold;
            font-size: 12px;
            padding: 12px 10px;
            border-radius: 50%;
            box-shadow: 0 4px 10px rgba(240,136,62,0.4);
        }

        /* Shop & Panels */
        .shop-panel {
            display: flex;
            justify-content: center;
            gap: 4px;
            padding: 0 5px;
            margin-bottom: 2px;
            flex-wrap: wrap;
        }
        .shop-btn {
            background: #238636;
            color: #fff;
            border: none;
            padding: 3px 6px;
            font-size: 9px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
        }
        .shop-btn:active { opacity: 0.8; }
        
        .leaderboard {
            font-size: 10px;
            background: #161b22;
            width: 100%;
            max-width: 380px;
            margin: 2px auto;
            padding: 3px;
            border-radius: 5px;
            border: 1px solid #30363d;
            color: #8b949e;
            text-align: left;
            box-sizing: border-box;
        }
        .leaderboard-title { color: #00ffcc; font-weight: bold; text-align: center; margin-bottom: 1px; }
        .lb-row { display: flex; justify-content: space-between; padding: 1px 4px; }

        #launch-section { padding: 0 10px; }
        .action-btn {
            display: block;
            width: 100%;
            max-width: 380px;
            margin: 2px auto;
            padding: 5px;
            font-size: 11px;
            font-weight: bold;
            text-decoration: none;
            border-radius: 5px;
            border: none;
            cursor: pointer;
            background: #00ffcc;
            color: #000;
            box-shadow: 0 0 6px rgba(0,255,204,0.3);
        }
    </style>
</head>
<body>

    <h1>🦍 BABY HARAMBE: REVENGE</h1>
    
    <!-- Web3 Wallet Connection Bar -->
    <div class="web3-bar">
        <div>Token: <span style="color:#00ffcc;">$BHARAMBE</span></div>
        <div>
            <button class="wallet-btn" id="connect-wallet-btn" onclick="connectWallet()">Connect Wallet</button>
            <span class="wallet-info" id="wallet-display"></span>
        </div>
    </div>

    <div class="ui-panel">
        <div>Score: <span id="score">0</span></div>
        <div>Level: <span id="level">1</span></div>
        <div>Coins: <span id="coins">0</span> 🍌</div>
    </div>
    <div id="boss-alert"></div>
    
    <div id="game-container">
        <canvas id="gameCanvas" width="400" height="190"></canvas>
    </div>

    <!-- Shop & Upgrades (Guns & Extras) -->
    <div class="shop-panel">
        <button class="shop-btn" onclick="upgradeGun(2, 40)">⚡ Rapid (40)</button>
        <button class="shop-btn" onclick="upgradeGun(3, 80)">💥 Triple (80)</button>
        <button class="shop-btn" onclick="upgradeGun(4, 150)">🔥 Plasma (150)</button>
        <button class="shop-btn" onclick="triggerBonusRound()">🎁 Bonus Round</button>
    </div>

    <!-- Leaderboard UI -->
    <div class="leaderboard">
        <div class="leaderboard-title">🏆 ON-CHAIN DEGEN LEADERBOARD</div>
        <div class="lb-row"><span>1. <span id="lb-name-0">Harambe</span></span> <span id="lb-score-0">500</span></div>
        <div class="lb-row"><span>2. <span id="lb-name-1">Satoshi</span></span> <span id="lb-score-1">300</span></div>
        <div class="lb-row"><span>3. <span id="lb-name-2">DegenApe</span></span> <span id="lb-score-2">100</span></div>
    </div>

    <!-- On-Screen Touch Controls -->
    <div class="controls">
        <div class="btn-group">
            <button class="control-btn" id="up-btn">⬆️</button>
            <button class="control-btn" id="down-btn">⬇️</button>
        </div>
        <button class="control-btn" id="throw-btn">🍌 THROW</button>
    </div>

    <div id="launch-section">
        <!-- Replace '#' with your actual pump.fun link -->
        <a id="buy-token-btn" class="action-btn" href="#" target="_blank">🚀 Buy $BHARAMBE on Pump.fun</a>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        let score = 0;
        let coins = 0;
        let level = 1;
        let userWalletAddress = null;
        let userWalletName = "Anon";

        let leaderboard = JSON.parse(localStorage.getItem("bharambe_web3_lb")) || [
            { name: "Harambe", score: 500 },
            { name: "Satoshi", score: 300 },
            { name: "DegenApe", score: 100 }
        ];
        updateLeaderboardDisplay();

        let player = { x: 25, y: 70, size: 34 };
        let bananas = [];
        let particles = [];
        let floatingTexts = [];
        
        // Gun Levels: 1=Normal, 2=Rapid, 3=Triple Spread, 4=Plasma Blaster
        let gunLevel = 1; 

        let keepers = [
            { x: 330, y: 15, speed: 1.2, hp: 1, maxHp: 1, alive: true },
            { x: 330, y: 75, speed: 1.5, hp: 1, maxHp: 1, alive: true },
            { x: 330, y: 135, speed: 1.0, hp: 1, maxHp: 1, alive: true }
        ];

        let bossActive = false;
        let boss = null;
        let bonusRoundActive = false;
        let bonusTimer = 0;

        let movingUp = false;
        let movingDown = false;
        let gameEnded = false;

        // Wallet Connection Support (Phantom, Solflare, Fomo, EVM/MetaMask general injection)
        async function connectWallet() {
            try {
                if (window.solana && (window.solana.isPhantom || window.solana.isSolflare)) {
                    const resp = await window.solana.connect();
                    userWalletAddress = resp.publicKey.toString();
                } else if (window.ethereum) {
                    const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
                    userWalletAddress = accounts[0];
                } else {
                    userWalletAddress = prompt("Enter your Web3 Wallet Address or Handle:", "DegenHolder");
                }

                if (userWalletAddress) {
                    if (userWalletAddress.length > 10) {
                        userWalletName = userWalletAddress.substring(0, 4) + '...' + userWalletAddress.substring(userWalletAddress.length - 4);
                    } else {
                        userWalletName = userWalletAddress;
                    }
                    document.getElementById("wallet-display").innerText = userWalletName;
                    document.getElementById("connect-wallet-btn").innerText = "Linked ✅";
                }
            } catch (err) {
                console.error("Wallet connection error:", err);
                alert("Connection declined or unsupported browser environment.");
            }
        }

        // Touch Listeners for mobile/smartphones
        document.getElementById("up-btn").addEventListener("touchstart", (e) => { e.preventDefault(); movingUp = true; });
        document.getElementById("up-btn").addEventListener("touchend", () => { movingUp = false; });
        document.getElementById("down-btn").addEventListener("touchstart", (e) => { e.preventDefault(); movingDown = true; });
        document.getElementById("down-btn").addEventListener("touchend", () => { movingDown = false; });

        document.getElementById("throw-btn").addEventListener("touchstart", (e) => {
            e.preventDefault();
            if (!gameEnded) shootBananas();
        });

        function shootBananas() {
            let speed = gunLevel >= 2 ? 8.5 : 5.5;
            let color = gunLevel === 4 ? "#00ffff" : "#ffe600";
            
            bananas.push({ x: player.x + 32, y: player.y + 12, vx: speed, vy: 0, color: color, plasma: gunLevel === 4 });

            if (gunLevel >= 3) {
                bananas.push({ x: player.x + 32, y: player.y + 12, vx: 7.5, vy: -1.4, color: color, plasma: gunLevel === 4 });
                bananas.push({ x: player.x + 32, y: player.y + 12, vx: 7.5, vy: 1.4, color: color, plasma: gunLevel === 4 });
            }
        }

        function upgradeGun(lvl, cost) {
            if (coins >= cost && gunLevel < lvl) {
                coins -= cost;
                gunLevel = lvl;
                alert(`Successfully Upgraded Weapon Level ${lvl}!`);
            } else {
                alert("Not enough coins or already upgraded!");
            }
            document.getElementById("coins").innerText = coins;
        }

        function triggerBonusRound() {
            if (coins >= 25 && !bonusRoundActive) {
                coins -= 25;
                bonusRoundActive = true;
                bonusTimer = 400; // frames of bonus rain
                document.getElementById("boss-alert").innerText = "🎁 BONUS COIN RAIN ACTIVE! 🎁";
            } else {
                alert("Need 25 Coins to trigger a Bonus Round!");
            }
            document.getElementById("coins").innerText = coins;
        }

        function createExplosion(x, y, isBoss) {
            let count = isBoss ? 35 : 12;
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: x, y: y,
                    vx: (Math.random() - 0.5) * 7,
                    vy: (Math.random() - 0.5) * 7,
                    radius: Math.random() * 3 + 2,
                    color: isBoss ? ['#ffd700', '#ff0000', '#ff8800'][Math.floor(Math.random() * 3)] : ['#ff4400', '#ffbb00', '#fff'][Math.floor(Math.random() * 3)],
                    life: 25
                });
            }
        }

        function addFloatingText(text, x, y) {
            floatingTexts.push({ text: text, x: x, y: y, life: 30 });
        }

        function checkLeaderboard(finalScore) {
            let nameToSubmit = userWalletName !== "Anon" ? userWalletName : prompt("🔥 NEW HIGH SCORE! Enter your Degen handle:", "CryptoApe");
            if (!nameToSubmit || nameToSubmit.trim() === "") nameToSubmit = "Anonymous";
            
            leaderboard.push({ name: nameToSubmit.trim().substring(0, 12), score: finalScore });
            leaderboard.sort((a, b) => b.score - a.score);
            leaderboard = leaderboard.slice(0, 3); // Top 3
            
            localStorage.setItem("bharambe_web3_lb", JSON.stringify(leaderboard));
            updateLeaderboardDisplay();
        }

        function updateLeaderboardDisplay() {
            for (let i = 0; i < 3; i++) {
                if (leaderboard[i]) {
                    document.getElementById(`lb-name-${i}`).innerText = leaderboard[i].name;
                    document.getElementById(`lb-score-${i}`).innerText = leaderboard[i].score;
                } else {
                    document.getElementById(`lb-name-${i}`).innerText = "---";
                    document.getElementById(`lb-score-${i}`).innerText = "0";
                }
            }
        }

        function checkMilestones() {
            if (score >= 250 && level === 1 && !bossActive) {
                spawnBoss("LEVEL 1 BOSS: CHIEF KEEPER!");
                level = 2;
            } else if (score >= 600 && level === 2 && !bossActive) {
                spawnBoss("LEVEL 2 BOSS: ZOO DIRECTOR!");
                level = 3;
            } else if (score >= 1200 && level === 3 && !bossActive) {
                spawnBoss("FINAL BOSS: THE VETERINARIAN!");
                level = 4;
            }
            document.getElementById("level").innerText = level;
        }

        function spawnBoss(title) {
            bossActive = true;
            keepers.forEach(k => k.alive = false);
            document.getElementById("boss-alert").innerText = `⚠️ ${title} ⚠️`;

            boss = {
                x: 320,
                y: 50,
                width: 30,
                height: 40,
                hp: level * 6,
                maxHp: level * 6,
                speed: 1.4 + (level * 0.3)
            };
        }

        function update() {
            if (gameEnded) return;

            if (movingUp && player.y > 5) player.y -= 3.6;
            if (movingDown && player.y < canvas.height - player.size - 5) player.y += 3.6;

            // Handle Bonus Round Coin Rain Drops
            if (bonusRoundActive) {
                bonusTimer--;
                if (Math.random() < 0.15) {
                    coins += 2;
                    addFloatingText("+2 🍌", Math.random() * 300 + 50, Math.random() * 150 + 20);
                }
                if (bonusTimer <= 0) {
                    bonusRoundActive = false;
                    document.getElementById("boss-alert").innerText = "";
                }
            }

            // Update Projectiles
            bananas.forEach((b, bIndex) => {
                b.x += b.vx;
                if (b.vy) b.y += b.vy;

                // Boss Hit Detection
                if (bossActive && boss) {
                    if (b.x > boss.x && b.x < boss.x + boss.width && b.y > boss.y && b.y < boss.y + boss.height) {
                        bananas.splice(bIndex, 1);
                        boss.hp -= (b.plasma ? 2 : 1);
                        createExplosion(b.x, b.y, false);

                        if (boss.hp <= 0) {
                            createExplosion(boss.x + 15, boss.y + 20, true);
                            score += 350;
                            coins += 60; 
                            bossActive = false;
                            boss = null;
                            document.getElementById("boss-alert").innerText = "BOSS DEFEATED! +60 Coins!";
                            setTimeout(() => { if(!bonusRoundActive) document.getElementById("boss-alert").innerText = ""; }, 3000);
                            
                            keepers.forEach(k => { k.alive = true; k.y = Math.random() * 120; });
                        }
                    }
                }

                // Regular Guard Hit Detection
                keepers.forEach(k => {
                    if (k.alive && b.x > k.x && b.x < k.x + 24 && b.y > k.y && b.y < k.y + 32) {
                        bananas.splice(bIndex, 1);
                        createExplosion(k.x + 12, k.y + 16, false);
                        k.alive = false;
                        score += 50;
                        coins += 10; 
                        addFloatingText("+10 🍌", k.x, k.y);

                        setTimeout(() => {
                            if (!bossActive && !gameEnded) {
                                k.alive = true;
                                k.y = Math.random() * (canvas.height - 40);
                            }
                        }, 1400);
                    }
                });

                if (b.x > canvas.width || b.y < 0 || b.y > canvas.height) {
                    bananas.splice(bIndex, 1);
                }
            });

            // Guard Movement & Collision with Player
            if (!bossActive) {
                keepers.forEach(k => {
                    if (k.alive) {
                        k.y += k.speed;
                        if (k.y > canvas.height - 35 || k.y < 5) k.speed *= -1;
                        
                        if (Math.abs(k.x - player.x) < 22 && Math.abs(k.y - player.y) < 22) {
                            gameEnded = true;
                            document.getElementById("boss-alert").innerText = "CAPTURED! Game Over.";
                            checkLeaderboard(score);
                        }
                    }
                });
            }

            if (bossActive && boss) {
                boss.y += boss.speed;
                if (boss.y > canvas.height - 45 || boss.y < 5) boss.speed *= -1;
            }

            particles.forEach((p, index) => {
                p.x += p.vx;
                p.y += p.vy;
                p.life--;
                if (p.life <= 0) particles.splice(index, 1);
            });

            floatingTexts.forEach((ft, index) => {
                ft.y -= 0.6;
                ft.life--;
                if (ft.life <= 0) floatingTexts.splice(index, 1);
            });

            checkMilestones();
            document.getElementById("score").innerText = score;
            document.getElementById("coins").innerText = coins;
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw Baby Harambe (Green Beanie)
            ctx.fillStyle = "#3b7a57"; 
            ctx.fillRect(player.x + 7, player.y - 6, 20, 7);
            ctx.fillStyle = "#4a3319"; 
            ctx.fillRect(player.x, player.y + 2, 32, 32);
            ctx.fillStyle = "#ffcc00"; 
            ctx.beginPath();
            ctx.arc(player.x + 25, player.y + 18, 5, 0, Math.PI * 2);
            ctx.fill();
            ctx.font = "11px sans-serif";
            ctx.fillText("🦍", player.x + 3, player.y + 23);

            // Draw Projectiles
            bananas.forEach(b => {
                ctx.fillStyle = b.color;
                ctx.beginPath();
                ctx.arc(b.x, b.y, b.plasma ? 6 : 4, 0, Math.PI * 2);
                ctx.fill();
            });

            // Draw Regular Keepers
            if (!bossActive) {
                keepers.forEach(k => {
                    if (k.alive) {
                        ctx.fillStyle = "#1f6feb";
                        ctx.fillRect(k.x, k.y, 24, 32);
                        ctx.font = "11px sans-serif";
                        ctx.fillText("👮", k.x + 2, k.y + 21);
                    }
                });
            }

            // Draw Boss Character
            if (bossActive && boss) {
                ctx.fillStyle = "#dc2626";
                ctx.fillRect(boss.x, boss.y, boss.width, boss.height);
                ctx.font = "15px sans-serif";
                ctx.fillText("👹", boss.x + 3, boss.y + 25);

                ctx.fillStyle = "#333";
                ctx.fillRect(boss.x - 4, boss.y - 9, 38, 4);
                ctx.fillStyle = "#22c55e";
                ctx.fillRect(boss.x - 4, boss.y - 9, (boss.hp / boss.maxHp) * 38, 4);
            }

            // Draw Floating Bonus/Coin Text
            ctx.font = "bold 10px sans-serif";
            floatingTexts.forEach(ft => {
                ctx.fillStyle = "#00ffcc";
                ctx.fillText(ft.text, ft.x, ft.y);
            });

            // Draw Particles
            particles.forEach(p => {
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();
            });
        }

        function loop() {
            update();
            draw();
            requestAnimationFrame(loop);
        }

        loop();
    </script>
</body>
</html>
